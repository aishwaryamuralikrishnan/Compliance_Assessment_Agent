# Copy to .env and fill in. `.env` is git-ignored.
# The app reads OPENROUTER_API_KEY from the process environment first; .env is only a
# fallback for values that are not already set in the environment.

# --- Models (OpenRouter) ---------------------------------------------------------
# OPENROUTER_API_KEY is expected in your OS environment (you already have it there).
# Leave the line below commented out unless you want .env to supply it.
# OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Database (matches docker-compose.yml defaults) -----------------------------
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance
POSTGRES_DB=compliance
POSTGRES_PORT=5432
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliance

# --- LangSmith (optional during step 1; required for step 7) ---------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=compliance-assistant

# --- Seed accounts (used once by `python -m ingest.seed users`, or by the api container on its first start) ---
SEED_PM_PASSWORD=pm-password
SEED_DPO_PASSWORD=dpo-password

# --- Containers (docker compose up --build; docs/containers_design.md) -----------
# docker compose reads this file. DATABASE_URL above is for running on this machine; inside the
# containers it is set to the db container. OPENROUTER_API_KEY must be set (here or in the OS
# environment) for the first start, which embeds the corpus. SEED_ON_START=0 skips the seeding.
# SEED_ON_START=1

# --- Sign in with Google (api/oidc.py; docs/deployment_design.md) -------------------
# Leave OIDC_CLIENT_ID empty and the login page shows the password form only. The redirect URI
# registered with Google is PUBLIC_BASE_URL + /api/auth/oidc/callback (the web address, not the API's).
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated e-mail addresses that sign in as DPO; everyone else is OIDC_DEFAULT_ROLE
# (product_manager, or deny = only accounts the users table already knows).
DPO_EMAILS= aishwarya.muralikrishna@gmail.com
OIDC_DEFAULT_ROLE=product_manager

# --- Web API (api/) ----------------------------------------------------------------
# Signs the session cookie. Any long random string; without it the API uses a random per-process
# secret and logs a warning (sessions end when it restarts).
SESSION_SECRET=
# true behind HTTPS only (the cookie gets the Secure flag)
SESSION_COOKIE_SECURE=false
